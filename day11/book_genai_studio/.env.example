# Copy to .env and fill in. Leave OPENAI_API_KEY empty to run in Demo mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
# Comma-separated models users may pick in Settings
ALLOWED_MODELS=gpt-4o-mini,gpt-4o,gpt-4.1-mini,gpt-4.1
# Stop AI calls after this many dollars per day (0 = no limit). Strongly recommended on a public deploy.
DAILY_BUDGET_USD=1
# Upload limit (Vercel free plan: keep at 4 or less)
MAX_UPLOAD_MB=25
