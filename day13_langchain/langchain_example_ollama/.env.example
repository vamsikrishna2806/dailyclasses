# Copy this file to .env only if you need to change a setting. No API key is needed.

# Ollama server address (default is http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434

# Optional: LangSmith tracing (lesson 21)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_your_key_here
LANGSMITH_PROJECT=langchain-zero-to-hero
